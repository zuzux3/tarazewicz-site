# Environment template for production deployment
# Copy to .env.local or .env.production and fill with real values
# NEVER commit the real .env file

NODE_ENV=production

# App metadata
VITE_APP_NAME=Your App Name
VITE_APP_BASE_URL=https://your-domain.com
VITE_SITE_URL=https://your-domain.com
VITE_CONTACT_EMAIL=hello@your-domain.com

# API / backend
VITE_API_BASE_URL=https://api.your-domain.com
VITE_API_TIMEOUT_MS=15000

# Cloud / deployment metadata
CLOUD_PROVIDER=azure
CLOUD_PROJECT_ID=your-cloud-project-id
CLOUD_REGION=europe-west1
CLOUD_RESOURCE_GROUP=your-resource-group
CLOUD_SERVICE_NAME=your-service-name
CLOUD_DOMAIN=your-domain.com

# CI/CD credentials and tokens
CI_PIPELINE_TOKEN=replace-me
GITHUB_TOKEN=replace-me
CLOUD_ACCESS_TOKEN=replace-me

# Optional: custom domain / DNS
DNS_PROVIDER=cloudflare
DNS_API_TOKEN=replace-me

# Optional: security / auth values if needed later
JWT_SECRET=replace-me
SESSION_SECRET=replace-me
